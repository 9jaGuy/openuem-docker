openuem.epoh.casa {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_TOKEN}
	}
	@lan remote_ip 192.168.1.0/24 127.0.0.0/8
	handle @lan {
		reverse_proxy https://127.0.0.1:1323 {
			header_up Host openuem.epoh.casa:1323
			transport http {
				tls_server_name openuem.epoh.casa
				tls_trust_pool file {
					pem_file /etc/caddy/openuem/ca/ca.cer
				}
			}
		}
	}
	respond 403
}
openuem.epoh.casa:4443 {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_TOKEN}
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/openuem/ca/ca.cer
			}
		}
	}
	@lan remote_ip 192.168.1.0/24 127.0.0.0/8
	handle @lan {
		reverse_proxy https://127.0.0.1:1324 {
			header_up Host openuem.epoh.casa:1324
			header_up Client-Cert :{tls_client_certificate_der_base64}:
			transport http {
				tls_server_name openuem.epoh.casa
				tls_trust_pool file {
					pem_file /etc/caddy/openuem/ca/ca.cer
				}
			}
		}
	}
	respond 403
}
